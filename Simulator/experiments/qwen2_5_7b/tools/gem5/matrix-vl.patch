+// Number of vector elements this systolic-array instruction operates on,
+// read from the instruction's actual vl. Used instead of a hardcoded push/pop
+// size (which assumed vlmul==1) so f16 pushes and f32 pops stay balanced.
+int vectorElemCount(const gem5::minor::MinorDynInst &inst) {
+    if (inst.staticInst) {
+        auto *rv = dynamic_cast<const gem5::RiscvISA::RiscvStaticInst *>(
+            inst.staticInst.get());
+        if (rv)
+            return rv->machInst.vl;
+    }
+    return 8;
+}
